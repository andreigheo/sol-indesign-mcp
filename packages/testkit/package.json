{
  "name": "@sol/testkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/testkit/src"
  },
  "dependencies": {
    "@sol/protocol": "workspace:*",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
